APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Dhaka
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Panel
NIT_USER_MODEL=App\Models\User
NIT_SUPER_ADMIN_ROLE=1
NIT_DASHBOARD_PATH=/
NIT_LOGOUT_PATH=/login
NIT_DISK=public

# Sign-up
NIT_REGISTRATION=false
NIT_REGISTRATION_ROLE=user
NIT_REGISTRATION_VERIFY=true
NIT_REGISTRATION_CODE_MINUTES=2
NIT_REGISTRATION_PRUNE_DAYS=7
NIT_EMAIL_VERIFICATION=false

# Sign-in
NIT_OTP_LOGIN=true                # one-time code by e-mail / SMS (+ e-mail link)
NIT_OTP_MINUTES=2
NIT_PHONE_COUNTRY_CODE=880
NIT_PASSKEYS=true
NIT_PASSKEY_RP_ID=
NIT_PASSKEY_ORIGIN=
NIT_2FA_FOR_ADMINS=false
NIT_2FA_TRUST_DAYS=30
NIT_NEW_DEVICE_ALERT=true
NIT_GOOGLE_CLIENT_ID=
NIT_GOOGLE_CLIENT_SECRET=
NIT_FACEBOOK_CLIENT_ID=
NIT_FACEBOOK_CLIENT_SECRET=
NIT_SOCIAL_CREATE_USERS=false
NIT_CAPTCHA=                      # turnstile or recaptcha
NIT_CAPTCHA_SITE_KEY=
NIT_CAPTCHA_SECRET_KEY=
NIT_CAPTCHA_AFTER_FAILED_LOGINS=3

# Passwords
NIT_PASSWORD_CHANGE_CODE=true
NIT_PASSWORD_CODE_MINUTES=2
NIT_PASSWORD_RESET=code           # or link
NIT_PASSWORD_RESET_MINUTES=2
NIT_CONFIRM_MINUTES=15

# SMS (mail uses Laravel's MAIL_* keys; both can also be set in Settings › Mail & SMS)
NIT_SMS_DRIVER=log                # log, http or twilio
NIT_SMS_URL=
NIT_SMS_METHOD=POST
NIT_SMS_API_KEY=
NIT_SMS_SENDER_ID=
NIT_SMS_WITH_PLUS=false
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=

# Data and system
NIT_ACTIVITY_LOG=true
NIT_ACTIVITY_KEEP_DAYS=180
NIT_TRASH_DAYS=30
NIT_BACKUPS_KEEP=10
NIT_PDF_ENGINE=browser            # or dompdf
NIT_API=false
NIT_API_PREFIX=api/nit
NIT_API_TOKEN_DAYS=365
NIT_NOTIFICATIONS_POLL=30
NIT_NOTIFICATIONS_BROADCAST=false
NIT_DIGEST_TIME=08:00
NIT_WEBHOOKS_ALLOW_PRIVATE=false
NIT_WEBHOOKS_TIMEOUT=10
NIT_WEBHOOKS_KEEP_DAYS=30
NIT_APPROVALS_SKIP_SUPER_ADMINS=true

# scms-finance
SCMS_FINANCE_MEMBER_MODEL=App\Models\Member
SCMS_FINANCE_MEMBER_TABLE=members
SCMS_FINANCE_SELF_POSTING=false
SCMS_FINANCE_REQUIRE_BRANCH=true
SCMS_FINANCE_WITHDRAWAL_APPROVAL_ABOVE=
SCMS_FINANCE_SHARE_PRICE=
SCMS_FINANCE_SMS=false
SCMS_FINANCE_SMS_REMINDER_DAYS=2
SCMS_ADMISSION_FEE=
